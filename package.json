{
  "name": "csv-clearview",
  "displayName": "CSV ClearView",
  "publisher": "vinuthomas",
  "description": "A clear and powerful CSV viewer with colored columns, sticky headers, and SQL query capabilities.",
  "version": "1.3.1",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinuthomas/CSV-Clear-View-for-VSCode"
  },
  "bugs": {
    "url": "https://github.com/vinuthomas/CSV-Clear-View-for-VSCode/issues"
  },
  "homepage": "https://github.com/vinuthomas/CSV-Clear-View-for-VSCode#readme",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Visualization",
    "Data Science"
  ],
  "keywords": [
    "csv",
    "tsv",
    "psv",
    "excel",
    "xlsx",
    "viewer",
    "sql",
    "editor",
    "table",
    "grid",
    "spreadsheet",
    "data",
    "statistics"
  ],
  "activationEvents": [
    "onLanguage:csv",
    "onLanguage:tsv",
    "onLanguage:psv",
    "onCommand:csvClearView.openWithCsvEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "csv",
        "aliases": [
          "CSV",
          "csv"
        ],
        "extensions": [
          ".csv"
        ],
        "mimetypes": [
          "text/csv"
        ]
      },
      {
        "id": "tsv",
        "aliases": [
          "TSV",
          "tsv",
          "Tab Separated Values"
        ],
        "extensions": [
          ".tsv",
          ".tab"
        ],
        "mimetypes": [
          "text/tab-separated-values"
        ]
      },
      {
        "id": "psv",
        "aliases": [
          "PSV",
          "psv",
          "Pipe Separated Values"
        ],
        "extensions": [
          ".psv"
        ],
        "mimetypes": [
          "text/psv"
        ]
      }
    ],
    "commands": [
      {
        "command": "csvClearView.openWithCsvEditor",
        "title": "Open with CSV ClearView",
        "category": "CSV ClearView"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "csvClearView.openWithCsvEditor",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "csvClearView.openWithCsvEditor",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "csvClearView.edit",
        "displayName": "CSV ClearView",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.tab"
          },
          {
            "filenamePattern": "*.psv"
          },
          {
            "filenamePattern": "*.xlsx"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "CSV ClearView",
      "properties": {
        "csvClearView.stickyHeader": {
          "type": "boolean",
          "default": true,
          "description": "Enable sticky header for the first row."
        },
        "csvClearView.firstRowIsHeader": {
          "type": "boolean",
          "default": true,
          "description": "Treat the first row as a header row. When disabled, generic column names (Column 1, Column 2, …) are used and the first row is shown as data. Can also be toggled per file with the Headers toolbar button."
        },
        "csvClearView.alternatingRows": {
          "type": "boolean",
          "default": true,
          "description": "Enable alternating row background colors."
        },
        "csvClearView.forceTextColumnColoring": {
          "type": "boolean",
          "default": false,
          "description": "Force column coloring in Plain Text mode (performance may vary)."
        },
        "csvClearView.safeModeThreshold": {
          "type": "number",
          "default": 20,
          "description": "File size threshold (in MB) above which Safe Mode options are shown for large files."
        },
        "csvClearView.showSlowLoadPrompt": {
          "type": "boolean",
          "default": true,
          "description": "Show a prompt to switch to Plain Text mode if the grid takes too long to render."
        },
        "csvClearView.delimiter": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            ",",
            "\t",
            "|",
            ";"
          ],
          "enumDescriptions": [
            "Auto-detect delimiter from file content (recommended)",
            "Comma (,) — standard CSV",
            "Tab (\\t) — TSV files",
            "Pipe (|) — PSV files",
            "Semicolon (;) — common in European locales"
          ],
          "description": "Column delimiter to use when parsing delimited files. 'auto' detects from the file content."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "test-compile": "tsc -p ./",
    "test": "node tests/security.test.js && node tests/excel.test.js",
    "benchmark": "node --expose-gc benchmark/run.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.109.0",
    "@vscode/vsce": "^3.9.1",
    "ts-loader": "^9.5.7",
    "typescript": "^5.9.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^5.0.1"
  },
  "dependencies": {
    "alasql": "^4.17.2",
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "glob": "^13.0.0",
    "uuid": "^11.1.1"
  }
}
