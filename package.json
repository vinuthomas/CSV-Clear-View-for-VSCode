{
  "name": "csv-clearview",
  "displayName": "CSV ClearView",
  "publisher": "vinuthomas",
  "description": "Open 500MB+ CSV files without a size cliff — colored columns, real SQL queries, column profiling, and duplicate detection in one editor.",
  "version": "1.3.3",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinuthomas/CSV-Clear-View-for-VSCode"
  },
  "bugs": {
    "url": "https://github.com/vinuthomas/CSV-Clear-View-for-VSCode/issues"
  },
  "homepage": "https://github.com/vinuthomas/CSV-Clear-View-for-VSCode#readme",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Visualization",
    "Data Science"
  ],
  "keywords": [
    "csv",
    "tsv",
    "psv",
    "excel",
    "xlsx",
    "viewer",
    "sql",
    "editor",
    "table",
    "grid",
    "spreadsheet",
    "data",
    "statistics",
    "large files",
    "profiling",
    "duplicates",
    "data analysis",
    "log parsing",
    "regex",
    "delimiters"
  ],
  "activationEvents": [
    "onLanguage:csv",
    "onLanguage:tsv",
    "onLanguage:psv",
    "onCommand:csvClearView.openWithCsvEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "csv",
        "aliases": [
          "CSV",
          "csv"
        ],
        "extensions": [
          ".csv"
        ],
        "mimetypes": [
          "text/csv"
        ]
      },
      {
        "id": "tsv",
        "aliases": [
          "TSV",
          "tsv",
          "Tab Separated Values"
        ],
        "extensions": [
          ".tsv",
          ".tab"
        ],
        "mimetypes": [
          "text/tab-separated-values"
        ]
      },
      {
        "id": "psv",
        "aliases": [
          "PSV",
          "psv",
          "Pipe Separated Values"
        ],
        "extensions": [
          ".psv"
        ],
        "mimetypes": [
          "text/psv"
        ]
      }
    ],
    "commands": [
      {
        "command": "csvClearView.openWithCsvEditor",
        "title": "Open with CSV ClearView",
        "category": "CSV ClearView"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "csvClearView.openWithCsvEditor",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "csvClearView.openWithCsvEditor",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "csvClearView.edit",
        "displayName": "CSV ClearView",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.tab"
          },
          {
            "filenamePattern": "*.psv"
          },
          {
            "filenamePattern": "*.xlsx"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "CSV ClearView",
      "properties": {
        "csvClearView.stickyHeader": {
          "type": "boolean",
          "default": true,
          "description": "Enable sticky header for the first row."
        },
        "csvClearView.firstRowIsHeader": {
          "type": "boolean",
          "default": true,
          "description": "Treat the first row as a header row. When disabled, generic column names (Column 1, Column 2, …) are used and the first row is shown as data. Can also be toggled per file with the Headers toolbar button."
        },
        "csvClearView.alternatingRows": {
          "type": "boolean",
          "default": true,
          "description": "Enable alternating row background colors."
        },
        "csvClearView.forceTextColumnColoring": {
          "type": "boolean",
          "default": false,
          "description": "Force column coloring in Plain Text mode (performance may vary)."
        },
        "csvClearView.safeModeThreshold": {
          "type": "number",
          "default": 20,
          "description": "File size threshold (in MB) above which Safe Mode options are shown for large files."
        },
        "csvClearView.showSlowLoadPrompt": {
          "type": "boolean",
          "default": true,
          "description": "Show a prompt to switch to Plain Text mode if the grid takes too long to render."
        },
        "csvClearView.delimiter": {
          "type": "string",
          "default": "auto",
          "examples": [
            "auto",
            ",",
            "\t",
            "|",
            ";",
            "||",
            "::"
          ],
          "markdownDescription": "Column delimiter to use when parsing delimited files.\n\n- `auto` — detect from the file content (recommended)\n- A single character such as `,`, `\\t`, `|`, or `;`\n- A multi-character string such as `||` or `::`\n- A regular expression, when `#csvClearView.delimiterIsRegex#` is enabled\n\nCan also be set per file from the delimiter badge in the toolbar."
        },
        "csvClearView.delimiterIsRegex": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Treat `#csvClearView.delimiter#` as a regular expression rather than a literal string.\n\nFiles parsed with a regex delimiter are **read-only**: a pattern matches many different separators, so edited rows cannot be written back unambiguously. Patterns that can match an empty string, or that contain nested quantifiers, are rejected."
        },
        "csvClearView.savedDelimiters": {
          "type": "array",
          "default": [],
          "markdownDescription": "Named delimiters you have saved, shown in the delimiter picker in the toolbar.\n\nManaged from **Custom…** and **Manage saved…** on the delimiter badge, but can also be edited here directly.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Label shown in the delimiter picker, e.g. \"Double pipe\"."
              },
              "value": {
                "type": "string",
                "description": "The delimiter string, or a regular expression when isRegex is true."
              },
              "isRegex": {
                "type": "boolean",
                "default": false,
                "description": "Treat value as a regular expression. Files parsed this way are read-only."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "test-compile": "tsc -p ./",
    "test": "node tests/security.test.js && node tests/excel.test.js && node tests/delimiter.test.js",
    "benchmark": "node --expose-gc benchmark/run.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.109.0",
    "@vscode/vsce": "^3.9.1",
    "ts-loader": "^9.5.7",
    "typescript": "^5.9.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^5.0.1"
  },
  "dependencies": {
    "alasql": "^4.17.2",
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "glob": {
      ".": "^13.0.0",
      "minimatch": {
        "brace-expansion": "^5.0.9"
      }
    },
    "uuid": "^11.1.1"
  }
}
